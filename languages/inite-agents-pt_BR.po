msgstr "Verificação aprovada: o robots.txt já indica um sitemap. O seu é %s."

#: includes/class-inite-agents-admin-fixes.php:162
msgid "Check failed: robots.txt does not name your sitemap, so a crawler has to guess where it is."
msgstr "Verificação reprovada: o robots.txt não indica o seu sitemap, então um rastreador precisa adivinhar onde ele está."

#: includes/class-inite-agents-admin-fixes.php:164
msgid "Sitemap link"
msgstr "Link do sitemap"

#: includes/class-inite-agents-admin-fixes.php:164
msgid "Name the sitemap in robots.txt"
msgstr "Indicar o sitemap no robots.txt"

